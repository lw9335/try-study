# demo 不需要密钥；改成 aliyun 后调用真实模型。
MODEL_PROVIDER=demo
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 千问 AI 平台对应地址（使用该平台创建的 Key）：
# DASHSCOPE_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/gateway.sqlite
RUN_TIMEOUT_MS=120000
# Docker Compose PostgreSQL：本地 .env 请设置随机密码，不要提交真实值。
POSTGRES_PASSWORD=replace-with-local-random-password
# 不设置 DATABASE_URL 时使用 DATABASE_PATH 的 SQLite；Compose 自动设置 PostgreSQL 地址。
# DATABASE_URL=postgresql://gateway:password@localhost:5432/gateway
